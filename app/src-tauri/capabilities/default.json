{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "windowsdefender:*" }
      ]
    },
    "dialog:default",
    "core:app:default"
  ]
}